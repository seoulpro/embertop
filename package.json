{
  "name": "embertop",
  "version": "0.2.0",
  "description": "Ambient observability for people who run things: turns live server traffic into a campfire in your terminal.",
  "license": "MIT",
  "author": "Sumin Lim <lim@limsumin.com> (https://limsumin.com)",
  "homepage": "https://github.com/seoulpro/embertop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoulpro/embertop.git"
  },
  "bugs": {
    "url": "https://github.com/seoulpro/embertop/issues"
  },
  "keywords": [
    "terminal",
    "cli",
    "tui",
    "ambient",
    "observability",
    "server-sent-events",
    "access-log",
    "nginx",
    "monitoring",
    "dashboard"
  ],
  "bin": {
    "embertop": "./bin/embertop.mjs"
  },
  "exports": {
    "./collector": "./collector/source.mjs",
    "./parsers": "./collector/parsers.mjs"
  },
  "files": [
    "app",
    "bin",
    "cli",
    "collector",
    "deploy",
    "docs",
    "lib",
    "public",
    "scripts",
    "licenses",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "eslint.config.mjs",
    "next.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/collector.test.mjs tests/cli.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cli": "node bin/embertop.mjs",
    "collector": "node bin/embertop.mjs serve",
    "prepack": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.2"
  },
  "type": "module"
}
