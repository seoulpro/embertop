# Label displayed in the upper-right corner.
EMBERTOP_SITE_NAME=example.com

# Canonical public URL used for social metadata.
EMBERTOP_PUBLIC_URL=http://localhost:3000

# Optional build-time mount path. Rebuild after changing it.
EMBERTOP_BASE_PATH=

# Leave empty to read the machine the web server runs on.
# For production, point this to the collector's /stream endpoint or to an
# existing SSE endpoint that emits the Embertop telemetry schema.
EMBERTOP_UPSTREAM_URL=

# Kept on the server and never sent to the browser.
EMBERTOP_UPSTREAM_TOKEN=

# Access logs for the web server to tail when no upstream is configured.
# Comma-separated. Same formats as the CLI.
EMBERTOP_LOG_PATHS=
