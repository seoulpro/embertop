[Unit]
Description=Embertop web dashboard
After=network.target

[Service]
Type=simple
User=embertop
Group=embertop
# The built output is self-contained: copy .next/standalone here and nothing
# else. There is no npm install step on the server.
WorkingDirectory=/opt/embertop/web
EnvironmentFile=/etc/embertop/web.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/embertop/web/server.js
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
