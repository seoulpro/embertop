# Bind to localhost when a reverse proxy runs on the same server.
EMBERTOP_HOST=127.0.0.1
EMBERTOP_PORT=4318
EMBERTOP_SITE_NAME=example.com

# Required whenever EMBERTOP_HOST is not localhost.
EMBERTOP_COLLECTOR_TOKEN=replace-with-a-long-random-token

# Comma-separated Nginx combined-log or JSON-log paths.
EMBERTOP_LOG_PATHS=/var/log/nginx/access.log
EMBERTOP_LOG_FORMAT=auto

# Set false to replace every request path with /…
EMBERTOP_INCLUDE_PATHS=true
EMBERTOP_SAMPLE_INTERVAL_MS=1500

# Optional: override local CPU/memory/load values from an existing JSON API.
# Expected shape: {"cpu": 23.4, "memory": 51.2, "load1": 0.48}
EMBERTOP_METRICS_URL=
EMBERTOP_METRICS_TOKEN=
