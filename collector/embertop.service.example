[Unit]
Description=Embertop telemetry collector
After=network.target

[Service]
Type=simple
User=embertop
Group=adm
WorkingDirectory=/opt/embertop
EnvironmentFile=/etc/embertop/collector.env
ExecStart=/usr/bin/node /opt/embertop/collector/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
